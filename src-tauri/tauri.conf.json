{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "pixiv-slides",
  "mainBinaryName": "pixiv-slides",
  "version": "0.1.3",
  "identifier": "net.pixiv.slides",
  "build": {
    "beforeDevCommand": "./tools/frontend/fe.sh dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "./tools/frontend/fe.sh build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "pixiv-slides",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "ExcitedSpider",
    "homepage": "https://github.com/ExcitedSpider/pxv-screen-protector",
    "category": "Photography",
    "shortDescription": "A full-screen Pixiv slideshow for a desktop display",
    "longDescription": "Display followed artists or tag-based Pixiv feeds as a full-screen desktop slideshow.",
    "copyright": "Copyright (c) 2026 ExcitedSpider",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "resources": {
      "../LICENSE": "LICENSE"
    },
    "linux": {
      "appimage": {
        "files": {
          "/usr/share/icons/hicolor/scalable/apps/pixiv-slides.svg": "../app-icon.svg",
          "/usr/share/metainfo/net.pixiv.slides.metainfo.xml": "linux/net.pixiv.slides.metainfo.xml"
        }
      },
      "deb": {
        "files": {
          "/usr/share/icons/hicolor/scalable/apps/pixiv-slides.svg": "../app-icon.svg",
          "/usr/share/metainfo/net.pixiv.slides.metainfo.xml": "linux/net.pixiv.slides.metainfo.xml"
        }
      },
      "rpm": {
        "files": {
          "/usr/share/icons/hicolor/scalable/apps/pixiv-slides.svg": "../app-icon.svg",
          "/usr/share/metainfo/net.pixiv.slides.metainfo.xml": "linux/net.pixiv.slides.metainfo.xml"
        }
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
